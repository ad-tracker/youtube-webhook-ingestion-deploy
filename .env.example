# YouTube Webhook Ingestion - Deployment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# Deployment Mode Configuration
# =============================================================================
#
# This deployment supports both local and remote PostgreSQL/Valkey instances.
# Use Docker Compose profiles to control which services start:
#
# Deploy with BOTH local databases:
#   docker compose --profile local-postgres --profile local-valkey up -d
#
# Deploy with ONLY local PostgreSQL (remote Valkey):
#   docker compose --profile local-postgres up -d
#
# Deploy with ONLY local Valkey (remote PostgreSQL):
#   docker compose --profile local-valkey up -d
#
# Deploy with BOTH remote databases:
#   docker compose up -d
#
# When using remote databases, set DATABASE_URL and REDIS_URL below to point
# to your remote instances.
#
# =============================================================================

# =============================================================================
# Docker Image Configuration
# =============================================================================

# Docker image tag to deploy (default: latest)
# You can specify a specific version tag here for reproducible deployments
IMAGE_TAG=latest

# Admin UI image tag (default: latest)
ADMIN_UI_TAG=latest

# =============================================================================
# PostgreSQL Database Configuration
# =============================================================================

# --- For LOCAL PostgreSQL (when using --profile local-postgres) ---
# Database name
POSTGRES_DB=youtube_webhooks

# Database user
POSTGRES_USER=postgres

# Database password (REQUIRED - CHANGE THIS!)
# Generate a strong password: openssl rand -base64 32
POSTGRES_PASSWORD=changeme_generate_strong_password

# --- For REMOTE PostgreSQL (when NOT using --profile local-postgres) ---
# Full database connection URL pointing to your remote PostgreSQL instance
# Uncomment and set this when using a remote database
# Format: postgres://username:password@hostname:port/database?sslmode=require
# Examples:
#   DATABASE_URL=postgres://myuser:mypass@db.example.com:5432/youtube_webhooks?sslmode=require
#   DATABASE_URL=postgres://user:pass@10.0.1.50:5432/mydb?sslmode=disable
#
# When set, this overrides the default local connection string.
# Leave commented out when using local PostgreSQL (--profile local-postgres)
#DATABASE_URL=

# =============================================================================
# YouTube Webhook Service Configuration
# =============================================================================

# Webhook path (default: /webhook)
WEBHOOK_PATH=/webhook

# YouTube PubSubHubbub webhook secret (REQUIRED)
# This is used to verify the HMAC signature of incoming webhooks from YouTube
# Generate a strong secret: openssl rand -hex 32
# This same secret is used when subscribing to YouTube channels via PubSubHub
# The server will NOT start without this value set
WEBHOOK_SECRET=changeme_generate_webhook_secret

# API Keys for subscription management endpoints (REQUIRED)
# Comma-separated list of valid API keys for the /api/v1/subscriptions endpoint
# Generate secure API keys: openssl rand -hex 32
# Example: key1,key2,key3
API_KEYS=changeme_generate_api_keys

# =============================================================================
# Subscription Renewal Service Configuration
# =============================================================================

# Renewal check interval (default: 6h)
# How often to check for and renew expiring subscriptions
# Format: golang duration (e.g., 1h, 30m, 6h, 12h)
# Subscriptions expiring within 24 hours will be renewed
RENEWAL_INTERVAL=6h

# Batch size for renewal processing (default: 100)
# Maximum number of subscriptions to process per renewal check
BATCH_SIZE=100

# =============================================================================
# YouTube API v3 Configuration
# =============================================================================

# YouTube Data API v3 key (REQUIRED for enrichment and URL-based channel addition)
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable YouTube Data API v3 for your project
# Used by both the webhook service (for /api/v1/channels/from-url) and enrichment service
YOUTUBE_API_KEY=changeme_your_youtube_api_key

# Daily API quota limit (default: 10000)
# Default YouTube API v3 quota is 10,000 units per day
# You can request quota increases from Google Cloud Console
YOUTUBE_DAILY_QUOTA=10000

# Enrichment batch size (default: 50, max: 50)
# Number of videos to enrich in a single API call
# YouTube API allows up to 50 video IDs per request
ENRICHMENT_BATCH_SIZE=50

# Enrichment worker concurrency (default: 1)
# Number of concurrent workers processing enrichment jobs
# Higher values = faster processing but more API quota usage and memory
# For 512MB systems, keep at 1
ENRICHMENT_WORKERS=1

# Quota safety threshold percentage (default: 90)
# Stop processing when this percentage of daily quota is used
# Example: 90 means stop at 9,000 of 10,000 quota
QUOTA_THRESHOLD_PERCENT=90

# Enable enrichment service (default: true)
# Set to 'false' to disable enrichment without removing the service
ENRICHMENT_ENABLED=true

# =============================================================================
# Valkey Configuration (Redis-compatible)
# =============================================================================

# Valkey/Redis connection URL (used by webhook-service and enricher)
# Valkey is a Redis-compatible key-value store (fork of Redis 7.2.4)
#
# --- For LOCAL Valkey (when using --profile local-valkey) ---
# Default points to the local valkey service in Docker Compose
REDIS_URL=redis://valkey:6379/0
#
# --- For REMOTE Redis/Valkey (when NOT using --profile local-valkey) ---
# Set REDIS_URL to point to your remote Redis/Valkey instance
# Examples:
#   REDIS_URL=redis://my-redis.example.com:6379/0
#   REDIS_URL=redis://:password@redis.example.com:6379/0
#   REDIS_URL=rediss://user:pass@secure-redis.example.com:6380/0  (with TLS)
#
# When using a remote instance, uncomment and modify the line above

# =============================================================================
# Swag (Reverse Proxy & SSL/TLS) Configuration
# =============================================================================

# Your domain name (REQUIRED)
# This is the domain where your service will be accessible
# Example: webhooks.example.com
DOMAIN=webhooks.example.com

# Let's Encrypt validation method (default: http)
# Options: http, dns, duckdns
# For production, 'dns' is recommended if your DNS provider is supported
VALIDATION=http

# DNS plugin (only required if VALIDATION=dns)
# Example: cloudflare, route53, etc.
# See: https://docs.linuxserver.io/general/swag#docker-mods
DNSPLUGIN=

# Subdomains to include in the certificate (OPTIONAL)
# Example: www,api
# Use 'wildcard' for *.yourdomain.com
SUBDOMAINS=

# Additional domains to include in the certificate (OPTIONAL)
# Comma-separated list
# For admin UI: add admin.justinnewman.tech here if DOMAIN is set to yt.justinnewman.tech
# Or add 'admin' to SUBDOMAINS if DOMAIN is set to justinnewman.tech
EXTRA_DOMAINS=

# Certificate provider (OPTIONAL)
# Leave empty to use Let's Encrypt
CERTPROVIDER=

# Email address for Let's Encrypt notifications (OPTIONAL but recommended)
EMAIL=

# DNS propagation time in seconds (only for dns validation)
PROPAGATION=

# Only use subdomains, not the root domain (default: false)
ONLY_SUBDOMAINS=false

# Use Let's Encrypt staging server for testing (default: false)
# Set to 'true' for testing to avoid rate limits
STAGING=false

# User and Group IDs for Swag container (default: 1000)
# Match these to your host user for proper file permissions
PUID=1000
PGID=1000

# Timezone for Swag container (default: UTC)
# Example: America/New_York, Europe/London
TZ=UTC

# HTTP and HTTPS ports (default: 80 and 443)
# Change these if you need to use different ports on the host
HTTP_PORT=80
HTTPS_PORT=443

# =============================================================================
# Security Notes
# =============================================================================
#
# 1. NEVER commit the .env file to version control
# 2. Use strong, randomly generated passwords and API keys
# 3. Restrict .env file permissions: chmod 600 .env
# 4. Rotate API keys and passwords regularly
# 5. Use WEBHOOK_SECRET for webhook signature verification in production
# 6. Consider using Docker secrets for sensitive data in production
#
# =============================================================================
